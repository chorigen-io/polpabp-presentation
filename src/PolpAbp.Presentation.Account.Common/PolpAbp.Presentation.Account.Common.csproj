<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\configureawait.props" />
	<Import Project="..\..\common.props" />	

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>PolpAbp.Presentation.Account.Common</AssemblyName>
		<PackageId>PolpAbp.Presentation.Account.Common</PackageId>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>PolpAbp.Presentation.Account</RootNamespace>
		<IsPackable>true</IsPackable>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Volo.Abp.Identity.AspNetCore" Version="10.7.0" />
		<PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI" Version="10.7.0" />
		<PackageReference Include="Volo.Abp.Account.Application.Contracts" Version="10.7.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\..\fwt\src\PolpAbp.Framework.Domain.Shared\PolpAbp.Framework.Domain.Shared.csproj" />
	  <ProjectReference Include="..\..\..\fwt\src\PolpAbp.Framework.Core.Shared\PolpAbp.Framework.Core.Shared.csproj" />
	  <ProjectReference Include="..\..\..\fwt\src\PolpAbp.Framework.Application.Contracts\PolpAbp.Framework.Application.Contracts.csproj" />
	</ItemGroup>

	<!--
	  Transitive pins (chorigen-io/chorigen-file-system#100). ABP 10.7 pulls Microsoft.AspNetCore.DataProtection
	  10.0.11, which pulls System.Security.Cryptography.Xml and .Pkcs at 10.0.11, inside the 2026-10-13
	  denial-of-service advisories (fixed in 10.0.13). Versions follow the family manifest
	  (nanshiee-formsystem-tools targets/net10-abp10.7.json); drop both once ABP ships DataProtection >= 10.0.13.
	-->
	<ItemGroup>
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
	</ItemGroup>

</Project>
