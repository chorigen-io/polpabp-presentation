@page "/account/sign-in"
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.Account.Settings
@using Volo.Abp.AspNetCore.Mvc.UI.MultiTenancy.Localization
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Settings
@using AspNetCore.ReCaptcha
@using System.Web
@model PolpAbp.Presentation.Account.Web.Pages.Account.LoginModel
@inject IHtmlLocalizer<AccountResource> L

@{
    ViewData["Title"] = L["Account_SignIn_Title"].Value;
    ViewData["Description"] = "Sign in with your username/email or use SSO to log in quickly and easily";
    ViewData["Keywords"] = "login, sign in, account, SSO, username, email, password";
    ViewData["HideTenancyView"] = false;
}

@section docReady {
    <script type="text/javascript">
        const tenantId = '@Model.TenantId?.ToString()';
        const returnUrl = '@(Model.ReturnUrl)';
        const returnUrlHash = '@(Model.ReturnUrlHash)';
        const initEmail = '@(Model.Input.EmailAddress)';
        const initUserName = '@(Model.Input.UserName)';
        const isRecaptchaVisible = @Model.IsRecaptchaEnabled.ToString().ToLower();
        Lockr.prefix = 'lockr_';

        // The localized accessible-name format of a stored account's remove button, read from
        // the attribute Razor encoded it into; {0} is the account. The replacement is a function
        // so that a '$' in an address is never read as a replacement pattern, and Knockout's
        // attr binding writes the result as an attribute value, never as markup.
        const removeAccountLabelFormat = document.querySelector('.pick-one-account').getAttribute('data-remove-account-label') || '';

        function AppViewModel() {
            var self = this;

            self.removeAccountLabel = function (account) {
                return removeAccountLabelFormat.replace('{0}', function () { return account; });
            };

            self.optionsVisible = ko.observable(false);
            self.users = ko.observable([]);
            self.isUsingUserName = ko.observable(@Model.Input.IsUsingUserName.ToString().ToLower());
            
            self.formVisible = ko.pureComputed(function () {
                return !self.optionsVisible();
            });
            self.hasUserOptions = ko.pureComputed(function () {
                return self.users().length && self.formVisible();
            });
            self.isUsingEmail = ko.pureComputed(function () {
                return !self.isUsingUserName();
            });
            self.hasNoUserOptions = ko.pureComputed(function () {
                return !self.hasUserOptions();
            });
        }

        const viewModel = new AppViewModel();
        ko.applyBindings(viewModel);

        function refreshUserOptions(initState) {
            let users = Lockr.get('users');
            if (users && users.length) {
                let a = users.filter(x => x.tenantId == tenantId)
                .map(x => {
                    return {
                        email: x.email,
                        userName: x.userName,
                        tenantId: x.tenantId,
                        lastUpdated: $.timeago(new Date(x.lastUpdated))
                    }
                });
                viewModel.users(a);
                if (initState != undefined) {
                    viewModel.optionsVisible(initState);
                }
            } else {
                viewModel.users([]);
                viewModel.optionsVisible(false);
            }
        }

        function switchToUserName(username) {
            viewModel.isUsingUserName(true);
            setTimeout(() => {
                if (username) {
                    $('#Input_UserName').val(username);
                } else {
                    const a = $('#Input_UserName').val();
                    if (a == '__dummy') {
                        $('#Input_UserName').val('');
                    }
                }

                const b = $('#Input_EmailAddress').val();
                if (!b) {
                    $('#Input_EmailAddress').val('__dummy@dummy.net');
                }

                $('#Input_UserName').focus();
            });
        }

        function switchToEmailAddress(email) {
            viewModel.isUsingUserName(false);
            setTimeout(() => {
                if (email) {
                    $('#Input_EmailAddress').val(email);
                } else {
                    const a = $('#Input_EmailAddress').val();
                    if (a == '__dummy@dummy.net') {
                        $('#Input_EmailAddress').val('');
                    }
                }

                const b = $('#Input_UserName').val();
                if (!b) {
                    $('#Input_UserName').val('__dummy');
                }

                $('#Input_EmailAddress').focus();
            });
        }

        // Keyboard focus never drops to the page when a chooser control hides or re-renders
        // itself (R10-F1 review): the identifier input the form shows, or, after a remove, the
        // remove button now in the removed row's place, else the last one, else "use a different
        // account".
        function focusIdentifierInput() {
            setTimeout(() => {
                (viewModel.isUsingUserName() ? $('#Input_UserName') : $('#Input_EmailAddress')).focus();
            });
        }

        function focusAfterRemove(index) {
            if (!viewModel.optionsVisible()) {
                focusIdentifierInput();
                return;
            }
            const $removes = $('.pick-one-account .delete-me');
            if ($removes.length) {
                $removes.eq(Math.min(index, $removes.length - 1)).focus();
            } else {
                $('.pick-one-account .new-account').focus();
            }
        }

        $(document).ready(() => {

            // Check if we have the right version
            let system = Lockr.get('system');
            if (!system || !system.version || system.version != 1) {
                Lockr.flush();

                system = {
                    version: 1
                };
                Lockr.set('system', system);
            }

            $(".card").on('click', '.delete-me', (evt) => {
                const $target = $(evt.target).closest('.delete-me');
                const index = $('.pick-one-account .delete-me').index($target);
                const email = $target.data('email');
                if (email) {
                    let users = Lockr.get('users');
                    if (users) {
                        users = users.filter(a => !(a.email.toLowerCase() == email.toLowerCase() && a.tenantId == tenantId));
                        Lockr.set('users', users);
                        refreshUserOptions(true);
                        focusAfterRemove(index);
                    }
                } else {
                    const userName = $target.data('username');
                    if (userName) {
                        let users = Lockr.get('users');
                        if (users) {
                            users = users.filter(a => !(a.userName.toLowerCase() == userName.toLowerCase() && a.tenantId == tenantId));
                            Lockr.set('users', users);
                            refreshUserOptions(true);
                            focusAfterRemove(index);
                        }
                    }
                }
            });

            // The pick control is a link (href="#") so that it is focusable and Enter activates
            // it; the default is prevented so the address does not change.
            $(".card").on('click', '.pick-me', (evt) => {
                evt.preventDefault();
                const $target = $(evt.target).closest('.pick-me');
                const email = $target.data('email');
                if (email) {
                    viewModel.optionsVisible(false);
                    switchToEmailAddress(email);
                } else {
                    const userName = $target.data('username');
                    viewModel.optionsVisible(false);
                    switchToUserName(userName);
                }
            });

            $(".card").on('click', '.new-account', () => {
                viewModel.optionsVisible(false);
                focusIdentifierInput();
            });

            $(".card").on('click', 'a.go-back', () => {
                viewModel.optionsVisible(true);
            });

            $(".card").on('click', '.cg-switch-identifier', () => {
                const $box = $('#Input_IsUsingUserName');
                $box.prop('checked', !$box.prop('checked')).trigger('change');
            });

            $('#Input_IsUsingUserName').change(
                function () {
                    if (this.checked) {
                        switchToUserName();
                    } else {
                        switchToEmailAddress();
                    }
                });

            refreshUserOptions(!(initEmail || initUserName));
            if (initEmail) {
                switchToEmailAddress(initEmail);
            } else if (initUserName) {
                switchToUserName(initUserName);
            } else if (viewModel.users().length == 0) {
                // Switch to input form 
                viewModel.optionsVisible(false);
                switchToEmailAddress('');
            }

            // Update time
            setInterval(() => {
                refreshUserOptions(undefined);
            }, 60 * 1000);

            // Remove the spinner 
            $('#globalSpinner').remove();
        });
    </script>
}

<h1 class="mb-1 h3">@L["Account_SignIn_Heading"]</h1>
<div class="mb-4" data-bind="visible: hasUserOptions">
    <a class="go-back" style="cursor:pointer;">
        <i class="fa fa-chevron-left me-1"></i>@L["Account_Back"]
    </a>
</div>
<div class="mb-4" data-bind="visible: hasNoUserOptions">
    <a class="cg-back"  href="@Url.Page("./FindOrganization")">
        <i class="fas fa-chevron-left me-1"></i>@L["Account_Back"]
    </a>
</div>

<!-- Pick an account -->
@*  Every control of the chooser is reachable by keyboard (R10-F1): the pick control stays a
    link, with an href, so the address heading inside it keeps its heading role; the remove and
    "use a different account" controls are buttons, because they change the page rather than
    navigate. The remove button's accessible name names the account, from the format below,
    written as .Value so Razor attribute-encodes it. *@
<div class="pick-one-account" data-bind="visible: optionsVisible"
     data-remove-account-label="@L["Account_SignIn_RemoveAccount"].Value">
    <p>
        @L["Account_SignIn_PickAccount"]
    </p>
    <ul class="list-unstyled" data-bind="foreach: users">
        <li class="d-flex mb-4 border-bottom" data-bind="ifnot: $parent.isUsingUserName">
            <div class="flex-xl-shrink-0">
                <i class="far fa-user-circle fa-2x"></i>
            </div>
            <div class="flex-grow-1 ms-3">
                <div class="d-flex flex-row justify-content-between mb-0">
                    <a class="pick-me" href="#" style="cursor: pointer; text-decoration: none;" data-bind="attr: {'data-email': email}">
                        <h6 data-bind="text: email" class="text-dark">
                        </h6>
                        <p class="text-muted">
                            Last login: <span data-bind="text: lastUpdated"></span>
                        </p>
                    </a>
                    <button type="button" class="delete-me btn btn-link text-danger px-2 py-0 border-0 align-self-start" data-bind="attr: {'data-email': email, 'aria-label': $root.removeAccountLabel(email)}">
                        <i class="fas fa-trash" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </li>
        <li class="d-flex mb-4 border-bottom" data-bind="if: $parent.isUsingUserName">
            <div class="flex-xl-shrink-0">
                <i class="far fa-user-circle fa-2x"></i>
            </div>
            <div class="flex-grow-1 ms-3">
                <div class="d-flex flex-row justify-content-between mb-0">
                    <a class="pick-me" href="#" style="cursor: pointer; text-decoration: none;" data-bind="attr: {'data-username': userName}">
                        <h6 data-bind="text: userName" class="text-dark">
                        </h6>
                        <p class="text-muted">
                            Last login: <span data-bind="text: lastUpdated"></span>
                        </p>
                    </a>
                    <button type="button" class="delete-me btn btn-link text-danger px-2 py-0 border-0 align-self-start" data-bind="attr: {'data-username': userName, 'aria-label': $root.removeAccountLabel(userName)}">
                        <i class="fas fa-trash" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </li>
    </ul>
    <ul class="list-unstyled">
        <li class="d-flex mb-4">
            <div class="flex-xl-shrink-0">
                <i class="fas fa-plus-circle fa-2x"></i>
            </div>
            <div class="flex-grow-1 ms-3">
                <button type="button" class="btn btn-link h6 mb-0 p-0 pe-5 text-start new-account">
                    @L["Account_SignIn_UseDifferentAccount"]
                </button>
            </div>
        </li>
    </ul>
</div>


<div data-bind="visible: formVisible">

    <p data-bind="visible: isUsingUserName">
        @L["Account_SignIn_Intro_UserName"]
    </p>

    <p data-bind="visible: isUsingEmail">
        @L["Account_SignIn_Intro"]
    </p>

    <form method="post">

        <div class="mb-3" data-bind="visible: isUsingUserName">
            <label for="Input_UserName" class="form-label">@L["DisplayName:UserName"]<span class="text-danger ms-1" aria-hidden="true">*</span></label>
            <input asp-for="Input.UserName" class="form-control" autocomplete="username" aria-required="true" />
            <span asp-validation-for="Input.UserName" class="text-danger"></span>
        </div>

        <div class="mb-3" data-bind="visible: isUsingEmail">
            <label for="Input_EmailAddress" class="form-label">@L["DisplayName:EmailAddress"]<span class="text-danger ms-1" aria-hidden="true">*</span></label>
            <input asp-for="Input.EmailAddress" class="form-control" autocomplete="email" type="email" aria-required="true" />
            <span asp-validation-for="Input.EmailAddress" class="text-danger"></span>
        </div>

        @*  The bound field is posted, so it is kept and hidden rather than removed;
            only its presentation changes. The visible control is a button because it
            changes what this page asks for -- it does not submit or navigate. *@
        <input asp-for="Input.IsUsingUserName" class="d-none" type="checkbox" />

        <div class="mb-3">
            <button type="button" class="btn btn-link p-0 cg-switch-identifier"
                    data-bind="visible: isUsingEmail">
                @L["Account_SignIn_UseUsername"]
            </button>
            <button type="button" class="btn btn-link p-0 cg-switch-identifier"
                    data-bind="visible: isUsingUserName">
                @L["Account_SignIn_UseEmail"]
            </button>
        </div>

        <div class="d-grid gap-2">
            <abp-button type="submit" button-type="Primary" name="Action" value="Input" class="mt-3">
                @L["Continue"]
                <span class="spinner-box">
                </span>
            </abp-button>
        </div>
    </form>
</div>    

@*  The account-acquisition block that stood here was removed by feature
    20260901-144857-auth-surface-restyle (FR-005): a second full-width call to action
    beside a credential form competes with the one thing the user came to do, and its
    copy named a retired brand. Joining an organization remains reachable from the
    organization-selection step, which is where choosing an account route belongs. *@

<div id="globalSpinner" class="modal-spinner position-absolute top-0 w-100 h-100 bg-light bg-opacity-75 text-center">
    <div class="spinner-border position-relative top-50" role="status">
        <span class="visually-hidden">Loading ...</span>
    </div>
</div>