@page "/account/verify-password"
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.Account.Settings
@using Volo.Abp.AspNetCore.Mvc.UI.MultiTenancy.Localization
@using Volo.Abp.Settings
@using AspNetCore.ReCaptcha
@using System.Web
@model PolpAbp.Presentation.Account.Web.Pages.Account.LocalLoginModel
@inject IHtmlLocalizer<AccountResource> L
@{
    ViewData["Title"] = "Sign In (Username/Password)";
    ViewData["Description"] = "Log in to your account using your username and password.";
    ViewData["Keywords"] = "login, sign in, account, username, email, password";
    ViewData["ShowResetButton"] = true;
}

@if (Model.ShowActivationLink)
{
    <div class="alert alert-danger">
        <p>
            To keep things secure,
            we need you to activate your account using the link in the email we sent you. Didn't see it? No worries! We can send you a new activation email right away.
        </p>
        <form method="post">
            <p>
                Click <button type="submit" name="Action" value="ResendActivation" class="btn btn-link p-0 align-baseline">here</button> to request a new activation email.
            </p>
        </form>
        <p>
            Once you've activated your account, you can come back here and sign in!
        </p>
    </div>
}

<h1 class="mb-1 h3">
    Enter Password
</h1>
<div class="mb-4">
    <a href="@Url.Page("./Login")">
        <i class="fas fa-chevron-left me-1"></i>Back
    </a>
</div>

<p>
    Great to see you again!
    Please enter your password to sign in.
</p>

<form method="post">

    <div class="mb-3">
        <label for="Input_AccountId" class="form-label">@L["DisplayName:AccountId"]</label>
        <input asp-for="Input.AccountId" class="form-control" readonly autocomplete="username" />
    </div>

    <div class="mb-3 password-wrapper">
        <label for="Input_Password" class="form-label">@L["DisplayName:Password"]<span class="text-danger ms-1" aria-hidden="true">*</span></label>
        <div class="input-group">
            <input asp-for="Input.Password" class="form-control" data-auto-focus="true" autocomplete="current-password" />
            <button type="button" class="toggle-password btn btn-outline-secondary" aria-label="Show password" aria-pressed="false">
                <i class="toggle-icon fa fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <abp-input asp-for="Input.RememberMe" />
    </div>

    @if (Model.IsRecaptchaEnabled)
    {
        <div class="mb-3">
            @Html.ReCaptcha()
        </div>
    }

    <div class="d-grid gap-2">
        <abp-button type="submit" button-type="Primary" name="Action" value="Input">
            @L["Continue"]
            <span class="spinner-box"></span>
        </abp-button>
        <abp-button type="submit" button-type="Secondary" name="Action" value="ForgotPassword" formnovalidate="formnovalidate">
            @L["ForgotPassword"]
        </abp-button>
    </div>
</form>

